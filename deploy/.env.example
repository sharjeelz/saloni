# ============================================================================
# Salooni production host env — lives at /srv/salon/deploy/.env on the Oracle
# A1 box (gitignored, so `git pull` never touches it).
# Copy to `.env`, fill in real values, and keep it OFF git (chmod 600).
# Both docker-compose (build args, domains, DB) and the Laravel/Next containers
# read from this single file.
# ============================================================================

# --- Frontend build arg ------------------------------------------------------
# NEXT_PUBLIC_* values are INLINED into the client bundle when the web image is
# built. Since we build on this host, the value must be set HERE (not at
# runtime, and not in CI). Must be the public API origin + /api.
NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api

# --- Domains / TLS (Caddy) ---------------------------------------------------
API_DOMAIN=api.yourdomain.com
APP_DOMAIN=app.yourdomain.com
ACME_EMAIL=admin@yourdomain.com

# --- PostgreSQL (the `db` container) -----------------------------------------
POSTGRES_DB=salon
POSTGRES_USER=salon
POSTGRES_PASSWORD=CHANGE_ME_strong_password

# ============================================================================
# Laravel API (.env consumed by api / worker / scheduler containers)
# ============================================================================
APP_NAME=Salooni
APP_ENV=production
APP_DEBUG=false
APP_KEY=                                   # php artisan key:generate --show
APP_URL=https://api.yourdomain.com         # MUST be the real public API URL (logo/QR URLs derive from it)
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

# Talk to the db container by service name, not localhost.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=salon
DB_USERNAME=salon
DB_PASSWORD=CHANGE_ME_strong_password      # keep in sync with POSTGRES_PASSWORD

# Postgres-backed drivers (no Redis needed at this scale).
SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_LIFETIME=120

# Uploads stay on the local `public` disk (persisted via the `uploads` volume).
# To move to OCI Object Storage later: set FILESYSTEM_DISK=s3 and the AWS_* block
# below. Object Storage is S3-compatible — the Laravel s3 driver works unchanged
# as long as AWS_ENDPOINT and path-style addressing are set.
FILESYSTEM_DISK=public
# AWS_ACCESS_KEY_ID=                       # OCI "Customer Secret Key" access key
# AWS_SECRET_ACCESS_KEY=                   # its secret
# AWS_DEFAULT_REGION=me-jeddah-1
# AWS_BUCKET=salooni-uploads
# AWS_ENDPOINT=https://<namespace>.compat.objectstorage.me-jeddah-1.oraclecloud.com
# AWS_USE_PATH_STYLE_ENDPOINT=true
#
# Generate the keys: OCI Console → Profile → My profile → Customer Secret Keys
# → Generate. Find <namespace> under Tenancy details → Object Storage Namespace.

# CORS — restrict to the frontend origin (auth is Bearer-token, not cookies).
CORS_ALLOWED_ORIGINS=https://app.yourdomain.com

# --- SMS / OTP (one shared Salooni account; falls back to log until set) -----
SMS_API_GATEWAY=msegat
SMS_API_USERNAME=
SMS_API_KEY=
SMS_API_SENDER=Salooni                     # registered CITC sender name
# NEVER set OTP_EXPOSE_DEBUG_CODE in production (returns plaintext OTP).

# --- AI menu onboarding ------------------------------------------------------
ANTHROPIC_API_KEY=
# ANTHROPIC_MENU_MODEL=claude-sonnet-5

# --- WhatsApp (optional; SMS is default) -------------------------------------
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# --- Subscription billing (salon -> Salooni) ---------------------------------
PAYMENT_GATEWAY=moyasar
# MOYASAR_SECRET_KEY=

# --- Booking policy ----------------------------------------------------------
BOOKING_MAX_ACTIVE_PER_CUSTOMER=1

# --- Mail (transactional) ----------------------------------------------------
MAIL_MAILER=log
# MAIL_HOST= MAIL_PORT= MAIL_USERNAME= MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@yourdomain.com
MAIL_FROM_NAME=Salooni

LOG_CHANNEL=stack
LOG_LEVEL=warning

# --- Off-box DB backups (optional; see deploy/backup-db.sh) ------------------
# Uses the OCI Object Storage S3-compatible API via the aws CLI. Leave
# BACKUP_S3_BUCKET empty to keep backups on the box only.
# BACKUP_S3_BUCKET=salooni-backups
# BACKUP_S3_ENDPOINT=https://<namespace>.compat.objectstorage.me-jeddah-1.oraclecloud.com
# BACKUP_S3_REGION=me-jeddah-1
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
